# Copy this file to .env.local and fill in the values there.
# .env.local is gitignored. Do not commit real values.
#
# Local: project root .env.local
# Hosted (Vercel and similar): the same two names in the project environment settings.
#
# Supabase dashboard → Project Settings → API Keys.
# Use the project URL and the publishable key (also called the anon key).
# Do not put a secret key or service role key in either variable.
# Normal workspace requests use the publishable key and Row Level Security.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Required only for Super admin Create user. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
